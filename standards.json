{
  "schemaVersion": 2,
  "defaults": {
    "branch": "main",
    "branchPattern": "luna/<kebab-case-description>",
    "publicLicense": "MIT",
    "migrationDelivery": "pull-request",
    "allChangesUsePullRequests": true,
    "mergeRequiresApproval": true,
    "mergeMethod": "squash",
    "squashCommitTitle": "pull-request-title",
    "squashCommitMessage": "pull-request-body",
    "conventionalCommits": true,
    "conventionalPullRequestTitles": true,
    "pullRequestTemplate": {
      "source": "templates/github/pull_request_template.md",
      "destination": ".github/pull_request_template.md",
      "skillAsset": "skills/luna-project-standards/assets/pull_request_template.md",
      "requiredSections": ["Summary", "Validation", "Risks and follow-ups"],
      "adoption": "all-repositories",
      "migration": "reconcile-in-current-pull-request"
    },
    "defaultBackend": "rust-axum-tokio",
    "typescriptBackend": "tanstack-start",
    "apiStyle": "rest-openapi",
    "graphql": "forbidden",
    "tailwindMajor": 4,
    "tailwindV3Migration": "required-upgrade-in-current-pull-request",
    "componentVariantUtility": "class-variance-authority",
    "componentClassUtilities": ["cn"],
    "frontendDesign": {
      "theme": "system-aware-light-and-dark",
      "darkCanvas": "#000000",
      "darkSurfaces": "neutral-grayscale",
      "colorTokens": "semantic",
      "accent": "restrained-product-specific",
      "hierarchy": "spacing-borders-surface-contrast",
      "cornerStyle": "modest-consistent",
      "density": "context-appropriate",
      "defaultControlMinHeightRem": 2.75,
      "preserveExistingIdentityUnlessRedesignRequested": true
    },
    "oneVariableDeclarationPerStatement": true,
    "handwrittenBarrelFiles": "forbidden",
    "generatedBarrelFiles": "allowed",
    "reactLintPlugin": "oxlint-plugin-react-doctor",
    "standaloneReactDoctorCli": false,
    "typescriptPackageManager": "pnpm",
    "typescriptTestRunner": "vitest",
    "newTypeScriptFormatter": "oxfmt",
    "newTypeScriptLinter": "oxlint",
    "rustTestRunner": "cargo-nextest",
    "toolVersionManager": "mise",
    "dependencyUpdater": "renovate",
    "typescriptReleaseTool": "changesets",
    "rustReleaseTool": "release-plz",
    "typescriptLogger": "evlog",
    "rustLogger": "tracing",
    "preserveExistingPackageManager": true,
    "preserveExistingFramework": true,
    "frontendNavigation": {
      "pagesAndResources": "slash-path-routes",
      "navigableTabs": "slash-path-routes",
      "queryParameterRouting": "forbidden",
      "hashRouting": "forbidden",
      "queryParametersFor": ["search", "filters", "sorting", "pagination"],
      "fragmentsFor": "in-page-anchors",
      "legacyLinkMigration": "only-when-explicitly-requested"
    },
    "backwardsCompatibility": "only-when-explicitly-requested",
    "pullRequestTitleWorkflow": "ImLunaHey/project-standards/.github/workflows/pr-title.yml"
  },
  "profiles": {
    "typescript-library": {
      "standards": ["base", "typescript", "testing", "github"]
    },
    "node-service": {
      "standards": ["base", "typescript", "backend", "data", "testing", "github"]
    },
    "frontend": {
      "standards": ["base", "typescript", "frontend", "testing", "github"]
    },
    "fullstack-app": {
      "standards": [
        "base",
        "typescript",
        "frontend",
        "backend",
        "data",
        "rust",
        "testing",
        "github"
      ]
    },
    "rust-cli": {
      "standards": ["base", "rust", "testing", "github"]
    },
    "rust-service": {
      "standards": ["base", "backend", "data", "rust", "testing", "github"]
    }
  },
  "requiredValidation": {
    "typescript": ["format", "lint", "typecheck", "test", "build"],
    "rust": [
      "cargo fmt --check",
      "cargo clippy --all-targets --all-features -- -D warnings",
      "cargo nextest run --all-features",
      "cargo test --doc --all-features"
    ],
    "frontend": [
      "accessibility-lint",
      "react-doctor-oxlint-rules",
      "component-tests",
      "playwright-critical-flows",
      "component-states-themes-and-responsive-visual-review",
      "slash-route-navigation-and-deep-links"
    ]
  },
  "forbiddenImplicitActions": [
    "merge",
    "publish",
    "deploy",
    "archive",
    "change-visibility",
    "create-remote-without-explicit-intent"
  ]
}
